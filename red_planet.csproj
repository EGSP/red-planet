<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.17.0" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <None Include="tools\**\*" />
  </ItemGroup>
  <!--
    Плагин редактора контента и его модель данных ссылаются на EditorInterface /
    EditorFileSystem. Эти типы есть только в Debug (конфигурация редактора, с TOOLS).
    ExportDebug и ExportRelease собираются без сборок редактора, поэтому исходники
    плагина из них исключаются.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'ExportDebug' Or '$(Configuration)' == 'ExportRelease'">
    <Compile Remove="addons\content_editor\**\*.cs" />
    <Compile Remove="scripts\data\editor\**\*.cs" />
  </ItemGroup>
</Project>