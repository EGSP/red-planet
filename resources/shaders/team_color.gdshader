shader_type canvas_item;

// Окраска спрайта в цвет команды.
//
// ИСХОДНЫЙ ЦВЕТ ТЕКСТУРЫ ИГНОРИРУЕТСЯ. Яркость берётся из канала R, а каналы G и B
// не читаются вовсе: спрайт рисуется в оттенках серого, и один и тот же файл годится
// любой стороне. Канал R выбран потому, что при сохранении в градациях серого все три
// канала совпадают, и брать один из них дешевле, чем считать светимость по трём.
//
// Каналы G и B при этом свободны и могут позже нести маски (свечение, износ), не ломая
// уже нарисованные спрайты: сейчас они просто не участвуют.
//
// ИСТОЧНИК — COLOR, А НЕ TEXTURE. К началу fragment в COLOR лежит цвет текстуры,
// уже умноженный на modulate узла, поэтому затухание и подсветка достаются даром.
// Читать TEXTURE напрямую и домножать на modulate вручную нельзя: встроенного
// идентификатора MODULATE в этой версии Godot нет.
//
// Альфа сохраняется без изменений, поэтому прозрачные поля остаются прозрачными.

uniform vec4 team_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);

// Доля окраски: 0 оставляет исходные цвета текстуры, 1 заменяет их цветом команды.
// Нужна для частей, которые окрашиваются лишь отчасти, и для сравнения при настройке.
uniform float strength : hint_range(0.0, 1.0) = 1.0;

// Поднятие яркости перед умножением на цвет команды. Чёрный пиксель остаётся чёрным
// при нуле; положительное значение осветляет тени, чтобы цвет читался и в тёмных местах.
uniform float lift : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	float luminance = mix(COLOR.r, 1.0, lift);
	vec3 tinted = team_color.rgb * luminance;

	COLOR = vec4(mix(COLOR.rgb, tinted, strength), COLOR.a * team_color.a);
}
