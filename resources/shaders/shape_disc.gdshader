shader_type canvas_item;
render_mode blend_mix, unshaded;

// Круг и кольцо служебной графики. Одна геометрия на обе фигуры: разбиения окружности
// на отрезки нет вовсе, форма считается расстоянием до центра прямо в растеризации,
// поэтому круг любого радиуса стоит два треугольника.
//
// ЧТО В ДАННЫХ ЭКЗЕМПЛЯРА, доли половины стороны четырёхугольника:
//   x — внешний радиус;
//   y — внутренний радиус, ноль для сплошного круга;
//   z — толщина обводки, отложенная по половине в обе стороны от радиуса;
//   w — доля прозрачности заливки от прозрачности обводки.
//
// ПОЧЕМУ ЗАЛИВКА ЗАДАНА ДОЛЕЙ, А НЕ СВОИМ ЦВЕТОМ. Экземпляр несёт один цвет, а заливка
// и обводка у фигур зоны различаются только плотностью при общем оттенке. Отсюда следует,
// что достаточно отношения: цвет экземпляра хранит обводку, заливка получается умножением.

varying flat vec4 shape;

void vertex() {
	shape = INSTANCE_CUSTOM;
}

void fragment() {
	// Расстояние до центра: 1 на середине стороны четырёхугольника
	float dist = length((UV - 0.5) * 2.0);
	float aa = max(fwidth(dist), 0.0001);

	float outer = shape.x;
	float inner = shape.y;
	float width = shape.z;

	// Тело фигуры: внутри внешнего радиуса и вне внутреннего. У сплошного круга
	// внутренней границы нет, и проверять её нельзя — у центра она съела бы точку
	float hole = inner > 0.0 ? smoothstep(inner - aa, inner + aa, dist) : 1.0;
	float body = (1.0 - smoothstep(outer - aa, outer + aa, dist)) * hole;

	// Обводка: полоса заданной толщины по обе стороны от границы
	float half_width = width * 0.5;
	float stroke = 1.0 - smoothstep(half_width - aa, half_width + aa, abs(dist - outer));

	if (inner > 0.0) {
		stroke = max(stroke,
			1.0 - smoothstep(half_width - aa, half_width + aa, abs(dist - inner)));
	}

	// Нулевая толщина означает отсутствие обводки, а не полосу в один пиксель
	stroke *= step(0.0001, width);

	COLOR.a *= max(stroke, body * shape.w);
}
