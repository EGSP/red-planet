#[compute]
#version 450

// Смещение показываемого поля к собранному — сглаживание границы во времени.
//
// ЗАЧЕМ. Собранное поле меняется скачком: пересборка идёт двадцать раз в секунду,
// и граница видимого прыгала бы вслед за юнитами ступенями. Показываемое поле каждый кадр
// смещается к собранному на долю оставшейся разницы, отчего граница движется непрерывно.
//
// СГЛАЖИВАТЬ МОЖНО ИМЕННО ЭТИ ЗНАЧЕНИЯ. В ячейке лежит расстояние до границы, а не признак
// видимости, поэтому среднее двух состояний само есть расстояние, и граница у него проходит
// между прежней и новой. С двоичной маской такое сглаживание дало бы полупрозрачный переход
// вместо движения границы.
//
// ПОТОК ЧИТАЕТ И ПИШЕТ ОДНУ ЯЧЕЙКУ, поэтому показываемое поле правится на месте: соседей
// проход не касается, и второй копии для обмена не нужно.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Собранное поле — цель движения
layout(r32ui, set = 0, binding = 0) uniform restrict readonly uimage2D field;

// Показываемое поле: его читает шейдер тумана
layout(r32f, set = 1, binding = 0) uniform restrict image2D shown;

layout(push_constant, std430) uniform Params {
    int width;
    float part;     // доля оставшейся разницы, проходимая за этот кадр
    float pad0;
    float pad1;
} params;

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);

    if (cell.x >= params.width || cell.y >= params.width)
        return;

    float target = float(imageLoad(field, cell).r) / 65535.0;
    float now = imageLoad(shown, cell).r;
    float value = now + (target - now) * params.part;

    // Показательный закон к цели не приходит никогда; остаток меньше ступени шкалы
    // округляется к цели, иначе граница замирала бы в доле пикселя от нужного места
    if (abs(target - value) < 1.0 / 65535.0)
        value = target;

    imageStore(shown, cell, vec4(value, 0.0, 0.0, 1.0));
}
