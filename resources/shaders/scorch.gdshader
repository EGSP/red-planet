shader_type canvas_item;

// Угасание отметин копоти. Считается здесь, а не в коде, по одной причине: отпечатков
// на карте сотни, все они лежат в одной множественной сетке и рисуются одним вызовом,
// а обновление прозрачности через SetInstanceColor означало бы запись в сетку на каждый
// отпечаток каждый кадр. Здесь же кадровой работы нет вовсе: код пишет одно число «now».
//
// ПОЧЕМУ СВОЁ ВРЕМЯ, А НЕ ВСТРОЕННОЕ TIME. Встроенное время идёт от запуска движка и
// к часам сессии отношения не имеет: срок отпечатка отсчитывается от того мига, когда он
// поставлен, и код обязан записать этот миг в данные экземпляра теми же часами, какими
// шейдер читает текущий. Общих с TIME часов у кода нет.

// Текущее время слоя, секунд от начала сессии. Пишется ScorchField раз в кадр.
uniform float now = 0.0;

// Данные экземпляра: x — когда поставлен, y — срок жизни, z — длительность угасания.
// Срок, равный нулю, означает отпечаток, который не гаснет.
varying vec4 stamp;

void vertex() {
	stamp = INSTANCE_CUSTOM;
}

void fragment() {
	float fade = 1.0;

	if (stamp.y > 0.0) {
		// Сколько секунд отпечатку осталось. Угасание отсчитывается внутрь срока,
		// поэтому полную прозрачность он набирает ровно к его концу
		float left = stamp.x + stamp.y - now;

		fade = stamp.z > 0.0 ? clamp(left / stamp.z, 0.0, 1.0) : step(0.0, left);
	}

	COLOR.a *= fade;
}
