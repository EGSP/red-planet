// Каркас строящейся постройки: спрайт, разделённый по высоте уровнем готовности.
//
// ОТКУДА ПРИЁМ. Planetary Annihilation строит модель снизу вверх шейдером
// prelight_pa_unit_fab: доля готовности build_fraction задаёт уровень, всё выше него
// отсекается, недостроенная часть красится цветом стороны, а граница подсвечивается
// отдельным цветом (fab_color). Здесь то же самое перенесено на плоский спрайт: отсечения
// нет, вместо него недостроенная часть показывается полупрозрачной сеткой.
//
// ПОЧЕМУ АКТИВНОСТЬ — ОТДЕЛЬНАЯ ВЕЛИЧИНА, А НЕ ПРИЗНАК. Строитель подключается и
// отключается мгновенно, и мгновенная остановка волнения читалась бы как рывок. Поэтому
// признак приходит сглаженным числом от нуля до единицы и служит множителем для всего, что
// движется: волнения уровня и бега полос. При нуле остаётся неподвижная сетка — каркас
// по-прежнему отличается от готовой постройки, но по нему видно, что работа стоит.
//
// ПОЧЕМУ УРОВЕНЬ СЧИТАЕТСЯ НЕ ПО МИРОВЫМ КООРДИНАТАМ. Уровень идёт вдоль корпуса, а корпус
// поворачивается вместе с постройкой, поэтому «низ» здесь есть низ рисунка, а не низ экрана.
// Так фронт готовности сохраняет своё место при любом угле постановки.
//
// ПОЧЕМУ НЕ ПО UV СПРАЙТА. Изображение сущности есть сцена из нескольких частей — корпус,
// треки, стволы, — и у каждой части свои UV, пробегающие от нуля до единицы по её
// собственному рисунку. Пока часть была одна на вид, разницы не было; с составной моделью
// каждая часть получала СВОЙ уровень готовности и свою фазу полос, отчего на каркасе разом
// виднелось несколько несогласованных сеток. Поэтому координата считается в осях САМОГО
// КАРКАСА и приводится к габариту всей модели: уровень тогда один на всё изображение,
// а UV остаются лишь для чтения силуэта.

shader_type canvas_item;

// Оси каркаса в мире: начало координат и единичный вектор его оси X. Через них мировое
// положение точки переводится в систему отсчёта каркаса, общую для всех частей модели.
uniform vec2 hull_origin;
uniform vec2 hull_axis = vec2(1.0, 0.0);

// Габарит модели в осях каркаса: угол с наименьшими координатами и размер. Ими положение
// приводится к долям от нуля до единицы — тем самым, в которых задан progress.
uniform vec2 hull_min = vec2(-32.0, -32.0);
uniform vec2 hull_size = vec2(64.0, 64.0);

// Положение точки в долях габарита модели. Заменяет собой UV везде, где речь об уровне
// готовности, о полосах и о колебании фронта.
varying vec2 hull_uv;

void vertex()
{
    vec2 world = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy;
    vec2 delta = world - hull_origin;

    // Поворот на минус угол каркаса выражен через его ось: обращать матрицу незачем,
    // а масштаба у слоя каркаса нет
    vec2 local = vec2(delta.x * hull_axis.x + delta.y * hull_axis.y,
        -delta.x * hull_axis.y + delta.y * hull_axis.x);

    hull_uv = (local - hull_min) / max(hull_size, vec2(1.0, 1.0));
}

// Доля готовности, 0..1
uniform float progress : hint_range(0.0, 1.0) = 0.0;

// Сглаженный признак работы: 0 — никто не строит, 1 — строят
uniform float activity : hint_range(0.0, 1.0) = 0.0;

// Цвет недостроенной части; альфа задаёт её плотность
uniform vec4 wire_color : source_color = vec4(0.35, 0.75, 1.0, 0.3);

// Цвет полосы фронта; альфа задаёт, насколько полоса перекрывает то, что под ней
uniform vec4 edge_color : source_color = vec4(0.75, 0.95, 1.0, 0.9);

// Непрозрачность готовой части: она остаётся проекцией до завершения строительства
uniform float built_opacity : hint_range(0.0, 1.0) = 0.72;

// Ширина полосы фронта, доля высоты спрайта
uniform float edge_width : hint_range(0.0, 0.3) = 0.05;

// Полос сетки по высоте спрайта
uniform float scan_count = 18.0;

// Насколько глубоко полосы гасят цвет недостроенной части
uniform float scan_strength : hint_range(0.0, 1.0) = 0.45;

// Скорость бега полос
uniform float scan_speed = 3.0;

// Размах колебания уровня, доля высоты спрайта
uniform float wave_amplitude : hint_range(0.0, 0.2) = 0.02;

// Периодов колебания на всю ширину спрайта
uniform float wave_frequency = 5.0;

// Скорость колебания уровня
uniform float wave_speed = 2.5;

void fragment()
{
    vec4 src = texture(TEXTURE, UV);

    // Ось Y направлена вниз, поэтому готовность растёт от единицы к нулю: при progress = 0
    // уровень стоит у нижнего края, при progress = 1 уходит за верхний
    float wave = sin(hull_uv.x * wave_frequency * 6.2831853 + TIME * wave_speed)
        * wave_amplitude * activity;
    float level = 1.0 - progress + wave;

    // Доля готовности точки: ниже уровня — корпус, выше — сетка. Переход размазан по
    // ширине полосы фронта, иначе граница шла бы лестницей по пикселям спрайта
    float half_edge = max(edge_width, 0.001) * 0.5;
    float built = smoothstep(level - half_edge, level + half_edge, hull_uv.y);

    // Близость к уровню: единица на самой границе, ноль на расстоянии полуширины
    float edge = clamp(1.0 - abs(hull_uv.y - level) / max(half_edge, 0.001), 0.0, 1.0);

    // Полосы проходят через всю конструкцию, включая уже проявленную часть. Движение
    // остаётся признаком работы, а при остановке сохраняется неподвижный рисунок.
    float scan = sin(hull_uv.y * scan_count * 6.2831853 - TIME * scan_speed * activity) * 0.5 + 0.5;
    float scan_line = smoothstep(0.58, 0.92, scan);
    vec3 wire = wire_color.rgb * (1.0 - scan_strength + scan_strength * scan);

    // Проявленная часть остаётся полупрозрачной голограммой: исходный цвет слегка
    // смещается к цвету каркаса, а линии выделяются цветом фронта.
    vec3 built_color = mix(src.rgb, wire_color.rgb, 0.18);
    built_color = mix(built_color, edge_color.rgb, scan_line * scan_strength * 0.55);
    float built_alpha = built_opacity * mix(0.82, 1.0, scan_line);

    vec3 rgb = mix(wire, built_color, built);
    float alpha = mix(wire_color.a, built_alpha, built);

    float edge_mix = edge * edge_color.a;
    rgb = mix(rgb, edge_color.rgb, edge_mix);
    alpha = max(alpha, edge_mix);

    // Силуэт берётся из альфы спрайта: сетка не выходит за корпус, поскольку каркас
    // показывает ту же постройку, что встанет на это место
    COLOR = vec4(rgb, src.a * alpha);
}
