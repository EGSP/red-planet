shader_type canvas_item;
render_mode blend_mix, unshaded;

// Прямоугольник служебной графики: рамка выделения, занятое место застройки, зазор вокруг
// него. Стороны прямоугольника идут по осям четырёхугольника, а сам он может быть повёрнут
// преобразованием экземпляра, поэтому наклонное место застройки рисуется той же формой.
//
// ЧТО В ДАННЫХ ЭКЗЕМПЛЯРА:
//   x, y — середина обводки по каждой оси, доля половины стороны четырёхугольника;
//   z — доля прозрачности заливки от прозрачности обводки;
//   w — доля обводки в поле за прямоугольником, общая для обеих осей.
//
// ПОЧЕМУ ТОЛЩИНА ЗАДАНА НЕ НАПРЯМУЮ. Четырёхугольник растянут под размер прямоугольника,
// и растяжение это неравномерное: одна доля стороны по ширине и по высоте означает разное
// число пикселей. Толщин, стало быть, нужно две, а свободных полей осталось одно. Выручает
// то, что поле за прямоугольником складывается из обводки и запаса на сглаживание, а оба
// они заданы мировыми величинами: доля обводки в этом поле по обеим осям одна и та же,
// и по ней толщина восстанавливается из положения середины обводки.
//
// ЗАЧЕМ ЗАПАС НА СГЛАЖИВАНИЕ. У повёрнутой рамки внешний край обводки идёт наискось
// к пикселям, и без запаса он обрезался бы границей геометрии, давая ступеньку.

varying flat vec4 shape;

void vertex() {
	shape = INSTANCE_CUSTOM;
}

void fragment() {
	// Расстояние от центра по каждой оси: 1 на краю четырёхугольника
	vec2 away = abs(UV - 0.5) * 2.0;

	// Середина обводки — край самого прямоугольника
	vec2 border = shape.xy;

	// Есть ли обводка вообще. Признак берётся числом, а не ветвлением: ветвление здесь
	// сбивало расчёт целиком, и заливка выходила на весь четырёхугольник
	float outlined = step(0.00001, shape.w);

	// Половина толщины обводки в долях половины стороны четырёхугольника
	vec2 half_width = max((1.0 - border) * shape.w, vec2(0.00001));

	// Расстояние до рамки, измеренное в её полных толщинах: ±0,5 приходятся на её края.
	// Большее из двух расстояний и есть расстояние до края прямоугольника, включая углы
	vec2 offset = (away - border) / (half_width * 2.0);
	float edge = max(offset.x, offset.y);
	float aa = max(fwidth(edge), 0.0001);

	float stroke = (1.0 - smoothstep(0.5 - aa, 0.5 + aa, edge))
		* smoothstep(-0.5 - aa, -0.5 + aa, edge) * outlined;

	// Заливка доходит до внутреннего края обводки. Без обводки поля вокруг прямоугольника
	// не отводилось вовсе, и заливка занимает весь четырёхугольник
	float body = mix(1.0, 1.0 - smoothstep(-0.5 - aa, -0.5 + aa, edge), outlined);

	COLOR.a *= max(stroke, body * shape.z);
}
