// Тень препятствий: затенение вокруг всего, что попадает в растр навигации.
//
// На вход подаётся сам растр одной текстурой. Значение канала — chamfer-расстояние до
// ближайшего непроходимого места в третях ячейки, то есть ровно то поле, по которому
// навигация решает, пройдёт ли юнит. Поэтому тень и плотность застройки говорят об одном:
// узкий проход затенён по всей ширине, а у отдельно стоящего здания тень ограничена каймой.
//
// РАССТОЯНИЕ ПЕРЕВОДИТСЯ В СВОБОДНОЕ МЕСТО. Расстояние меряется до ЦЕНТРА непроходимой
// ячейки, а препятствие занимает её целиком, поэтому половина ячейки вычитается — так же,
// как в NavGrid.FreeRadius. Полученная величина есть радиус круга, который помещается
// в этой точке, и ширина полосы затенения задаётся в тех же пикселях.
//
// ЦВЕТ БЕРЁТСЯ ИЗ ГРАДИЕНТА. Шейдер не знает ни цвета тени, ни формы спада: он приводит
// свободное место к отрезку от нуля до единицы и выбирает цвет из запечённой шкалы.
// Вся настройка вида остаётся в ресурсе ShadowSettings.
shader_type canvas_item;

// Цветовая шкала: 0 — вплотную к препятствию, 1 — на внешней границе полосы.
// repeat_disable обязателен: с повторением выборка на самом краю отрезка перескакивала бы
// к противоположному концу шкалы и давала полосу чужого цвета по границе тени
uniform sampler2D ramp : source_color, filter_linear, repeat_disable;

// Ширина полосы затенения, пикселей свободного места
uniform float width_px = 40.0;

// Сила угасания к границе полосы. Ноль оставляет плотность целиком за шкалой,
// единица гасит её линейно, большие значения сдвигают спад к самой границе
uniform float falloff = 1.0;

// Ячейка растра навигации, пикселей
uniform float cell_px = 16.0;

// Шаг chamfer-расстояния по стороне: во сколько долей ячейки считается расстояние
uniform float steps_per_cell = 3.0;

void fragment() {
	// Канал L8 отдаётся как доля от 255, а хранится в нём целое число шагов
	float steps = texture(TEXTURE, UV).r * 255.0;

	float free_px = (steps / steps_per_cell - 0.5) * cell_px;
	float t = clamp(free_px / max(width_px, 0.001), 0.0, 1.0);

	vec4 tint = texture(ramp, vec2(t, 0.0));

	// Плотность гасится множителем, а не отсечением. Множитель обращается в ноль ровно на
	// границе полосы, поэтому за ней цвета нет при любой шкале, а сама граница остаётся
	// гладкой: отсечение давало ступень по ячейкам растра
	tint.a *= pow(1.0 - t, falloff);

	COLOR = tint;
}
