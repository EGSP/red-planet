// Снаряд: одна чёрно-белая текстура, из которой выводится и прозрачность, и цвет.
//
// ЗАЧЕМ ШЕЙДЕР, А НЕ ПРОСТО СПРАЙТ. Рисунок снаряда нарисован яркостью по чёрному полю,
// и альфы в нём нет вовсе: чёрное поле непрозрачно наравне с самой полосой. Поэтому
// прозрачность берётся из яркости, а цвет назначается целиком отсюда — от рисунка остаётся
// только его форма. Один файл в оттенках серого годится любому цвету трассера, ровно
// по той же причине, по какой в оттенках серого нарисованы корпуса (unit_body.gdshader).
//
// СЛОЖЕНИЕ ЦВЕТОВ. Свечение обязано складываться с тем, что под ним: снаряд есть источник
// света, а не наклейка. При сложении яркость рисунка правит вкладом дважды — и через
// прозрачность, и через саму величину цвета, — отчего края полосы уходят в фон без каймы.
shader_type canvas_item;
render_mode blend_add;

// Цвет трассера. Альфа задаёт общую видимость: рисунок ею домножается целиком
uniform vec4 tint : source_color = vec4(1.0, 0.86, 0.45, 1.0);

// Насколько ярче собственного цвета светится середина. Единица оставляет цвет как есть
uniform float energy : hint_range(0.0, 4.0, 0.05) = 1.4;

void fragment() {
    // Канал R и есть яркость: текстура серая, и три канала в ней равны
    float mask = texture(TEXTURE, UV).r;

    COLOR = vec4(tint.rgb * energy, tint.a * mask);
}
