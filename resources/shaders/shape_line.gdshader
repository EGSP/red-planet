shader_type canvas_item;
render_mode blend_mix, unshaded;

// Отрезок служебной графики: тело множественной сетки фигур. Экземпляр — четырёхугольник
// со стороной в единицу, растянутый преобразованием на длину отрезка и на толщину вместе
// с запасом на сглаживание.
//
// ЦВЕТ ПРИХОДИТ ЭКЗЕМПЛЯРОМ, а не uniform материала: материал у сетки один на все отрезки,
// и оттенок вида приказа различаться через него не может. Запись идёт
// в MultiMesh.SetInstanceColor, а сюда попадает готовым COLOR.
//
// ЧТО В ДАННЫХ ЭКЗЕМПЛЯРА. Единственная величина — доля стороны, занятая самой полосой.
// Остальное поле четырёхугольника есть запас на сглаживание: без него внешний край полосы
// обрезался бы границей геометрии, и вместо плавного края получалась бы лестница.

varying flat float edge;

void vertex() {
	edge = INSTANCE_CUSTOM.x;
}

void fragment() {
	// Поперёк полосы: 0 по средней линии, 1 у края четырёхугольника
	float across = abs(UV.y - 0.5) * 2.0;
	float aa = max(fwidth(across), 0.0001);

	COLOR.a *= 1.0 - smoothstep(edge - aa, edge + aa, across);
}
