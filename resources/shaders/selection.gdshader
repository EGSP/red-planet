shader_type canvas_item;
render_mode blend_mix, unshaded;

// Материал метки выделения. Общий на все метки: изображение и геометрия у них одни,
// поэтому один материал на всю множественную сетку означает один вызов отрисовки
// на весь отряд. Цвет задан здесь, а не модуляцией отдельной метки, именно ради этого —
// у модуляции нет способа остаться общей, когда меток много.

// Цвет метки. Умножается на изображение, поэтому белый оставляет его как есть,
// а плотность задаётся альфой этого же цвета.
uniform vec4 tint : source_color = vec4(1.0, 0.9, 0.22, 0.85);

void fragment() {
	COLOR *= tint;
}
