shader_type canvas_item;

// Корпус сущности: окраска в цвет команды и слой повреждения, вскрывающий внутренности
// по мере убыли прочности.
//
// ЗАМЕНИЛ team_color.gdshader. Прежний шейдер умел только окраску, и слой повреждения
// пришлось бы вешать вторым узлом поверх корпуса — с отдельной копией того же спрайта,
// отдельным порядком отрисовки и отдельной тенью. Оба действия относятся к одному
// пикселю одного изображения, поэтому и считаются в одном месте.
//
// ИСХОДНЫЙ ЦВЕТ ТЕКСТУРЫ ИГНОРИРУЕТСЯ. Яркость берётся из канала R: спрайт рисуется
// в оттенках серого, и один и тот же файл годится любой стороне. При сохранении
// в градациях серого все три канала совпадают, и брать один дешевле, чем считать
// светимость по трём.
//
// ИСТОЧНИК — COLOR, А НЕ TEXTURE. К началу fragment в COLOR лежит цвет текстуры,
// уже умноженный на modulate узла, поэтому затухание и подсветка достаются даром.
// Читать TEXTURE напрямую и домножать на modulate вручную нельзя: встроенного
// идентификатора MODULATE в этой версии Godot нет.
//
// АЛЬФА СОХРАНЯЕТСЯ БЕЗ ИЗМЕНЕНИЙ. Отсюда следует главное свойство слоя повреждения:
// внутренности видны только там, где нарисован корпус, и за силуэт не выходят никогда.

// ПАРАМЕТР ЭКЗЕМПЛЯРА, А НЕ ВЕЩЕСТВА. Цвет принадлежит машине, а вещество — виду, и одно
// на всех носителей вида. Прежде каждой машине выдавалась копия вещества, отчего Godot
// переставал объединять картинки в общий вызов отрисовки; instance uniform хранится
// у самого объекта отрисовки и вещество оставляет одно — см. InstanceParam.
instance uniform vec4 team_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);

// Доля окраски корпуса: 0 оставляет исходные цвета текстуры, 1 заменяет их цветом команды.
// Нужна для спрайтов, нарисованных в цвете, — у заводов, например.
//
// НА ВНУТРЕННОСТИ НЕ ВЛИЯЕТ: они окрашиваются всегда. Текстура повреждения общая на все
// виды и нарисована в оттенках серого, поэтому оставлять её собственный цвет не в чем.
uniform float strength : hint_range(0.0, 1.0) = 1.0;

// Поднятие яркости перед умножением на цвет команды. Чёрный пиксель остаётся чёрным
// при нуле; положительное значение осветляет тени, чтобы цвет читался и в тёмных местах.
uniform float lift : hint_range(0.0, 1.0) = 0.0;

// ── слой повреждения ─────────────────────────────────────────────────────────────

// Внутренности: то, что видно на месте вскрытого корпуса. Общая текстура на семейство —
// своя у юнитов, своя у построек, своя у противника, — поэтому и выбирается материалом,
// а не задаётся у каждого вида. Не задана — внутренности выйдут ровным цветом команды.
uniform sampler2D damage_tex : hint_default_white, repeat_enable, filter_linear;

// Порядок вскрытия: чем темнее пиксель, тем раньше корпус в этом месте разойдётся.
// Не задана — слой повреждения не показывается вовсе, пока прочность не дойдёт до нуля.
uniform sampler2D dissolve_tex : hint_default_white, repeat_enable, filter_linear;

// Сколько раз текстура укладывается поперёк спрайта. Единица растягивает её ровно
// на весь рисунок, двойка кладёт вчетверо мельче.
//
// МЕРА — САМ СПРАЙТ, А НЕ ПИКСЕЛИ. Прежде обе текстуры клались на пиксели рисунка, отчего
// узор был одного размера у бота и у завода; на мелких видах это означало, что на корпус
// приходится клочок карты порядка, и вскрытие выглядело случайным пятном. Привязка к UV
// даёт каждому виду свой масштаб — где-то узор крупнее, где-то мельче, — зато на всяком
// корпусе укладывается целиком.
uniform float damage_scale = 1.0;
uniform float dissolve_scale = 1.0;

// Правка карты порядка перед сравнением с порогом.
//
// ЗАЧЕМ. Разброс яркости в карте и есть то, что растягивает вскрытие по ходу боя: собран
// шум около средней яркости — корпус расходится почти разом, растянут — вскрытие идёт
// по частям. Настройка нужна потому, что готовые карты приходят с какой угодно
// гистограммой, а перерисовывать их ради этого нельзя: они общие на семейство.
//
// Контраст растягивает разброс относительно середины: единица оставляет карту как есть,
// меньше единицы сводит её к середине, больше — разводит к краям.
uniform float dissolve_contrast : hint_range(0.0, 4.0) = 1.0;

// Смещение яркости. Положительное вскрывает корпус позже и меньшей площадью,
// отрицательное — раньше и большей.
uniform float dissolve_brightness : hint_range(-1.0, 1.0) = 0.0;

// Доля прочности: 1 — целая сущность, 0 — вскрытая целиком. Пишет её код, поскольку
// величина принадлежит сущности, а не виду; отсюда же и параметр экземпляра.
instance uniform float health : hint_range(0.0, 1.0) = 1.0;

// С какой прочности вскрытие начинается и на какой доходит до предела.
//
// ЗАЧЕМ. Прямая связь «порог равен единице минус прочность» означала, что подложка лезет
// с первого же попадания, и целых машин в бою не оставалось вовсе. Здесь прочность сперва
// переводится в долю вскрытия, и до damage_start корпус остаётся нетронутым.
uniform float damage_start : hint_range(0.0, 1.0) = 0.7;
uniform float damage_full : hint_range(0.0, 1.0) = 0.0;

// Изгиб перевода. Единица даёт равномерный ход, больше единицы придерживает начало
// и отдаёт основное вскрытие последним попаданиям, меньше — наоборот.
uniform float damage_curve : hint_range(0.1, 4.0) = 1.0;

// Ширина светящейся каймы на границе вскрытия, в долях шкалы порядка.
uniform float edge_width : hint_range(0.0, 0.5) = 0.06;

uniform vec4 edge_color : source_color = vec4(1.0, 0.55, 0.2, 1.0);

void fragment() {
	// Обе текстуры кладутся на сам рисунок: единица масштаба означает «на весь спрайт»
	vec2 damage_uv = UV * damage_scale;
	vec2 dissolve_uv = UV * dissolve_scale;

	float order = texture(dissolve_tex, dissolve_uv).r;

	// Контраст считается от середины шкалы: иначе он заодно двигал бы яркость,
	// и две настройки спорили бы друг с другом
	order = clamp((order - 0.5) * dissolve_contrast + 0.5 + dissolve_brightness, 0.0, 1.0);

	// Прочность переводится в долю вскрытия отрезком между damage_start и damage_full.
	// Знаменатель прикрыт от нуля: сойдись оба края в одну точку, деление обратилось бы
	// в бесконечность, и корпус вскрывался бы разом
	float span = max(damage_start - damage_full, 0.0001);
	float threshold = clamp((damage_start - health) / span, 0.0, 1.0);

	threshold = pow(threshold, damage_curve);

	// Множитель отсекает целую сущность: при полной прочности порог равен нулю,
	// и без него чёрные точки карты порядка вскрывались бы уже на нетронутом корпусе
	float opened = step(0.0001, threshold);

	float inner = step(order, threshold) * opened;
	float edge = (1.0 - step(edge_width, abs(order - threshold))) * opened;

	vec3 body = mix(COLOR.rgb, team_color.rgb * mix(COLOR.r, 1.0, lift), strength);
	vec3 guts = team_color.rgb * mix(texture(damage_tex, damage_uv).r, 1.0, lift);

	vec3 rgb = mix(body, guts, inner);
	rgb = mix(rgb, edge_color.rgb, edge * edge_color.a);

	COLOR = vec4(rgb, COLOR.a * team_color.a);
}
