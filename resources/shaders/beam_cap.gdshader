shader_type canvas_item;
render_mode blend_add, unshaded;

// Вспышка на конце луча — у среза инструмента и в точке попадания. Шейдер общий на обе:
// различаются они размером, цветом и текстурой, а не приёмом отрисовки. Сетки при этом
// разные, поскольку материал у сетки один на все её экземпляры.

// Доля радиуса, занятая яркой серединой. Дальше яркость спадает к краю.
uniform float core_share : hint_range(0.0, 1.0) = 0.35;

// Резкость спада от середины к краю. Единица даёт ровный спад, большие значения — тугую точку.
uniform float falloff : hint_range(0.25, 8.0) = 2.0;

// Разворот рисунка вокруг середины вспышки. Круглый спад яркости от этого не меняется —
// он строится из расстояния, — правится только выборка из текстуры.
uniform bool flip_x = false;
uniform bool flip_y = false;
uniform bool rotate_90 = false;

void fragment() {
	// Развороты считаются от середины квадрата, иначе рисунок уезжает за край
	vec2 uv = UV - vec2(0.5);

	if (rotate_90) {
		uv = vec2(uv.y, -uv.x);
	}

	if (flip_x) {
		uv.x = -uv.x;
	}

	if (flip_y) {
		uv.y = -uv.y;
	}

	vec4 tex = texture(TEXTURE, uv + vec2(0.5));

	// Круглое пятно строится из расстояния до середины квадрата. Оно нужно и с текстурой:
	// им задаётся спад яркости, а текстура остаётся рисунком поверх
	float dist = clamp(length(UV - vec2(0.5)) * 2.0, 0.0, 1.0);
	float spot = 1.0 - smoothstep(core_share, 1.0, dist);

	COLOR *= tex * pow(spot, falloff);
}
