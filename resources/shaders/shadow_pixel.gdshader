// Тень препятствий, ступенчатая по ячейкам растра навигации.
//
// Отличие от shadow.gdshader только в подаче: величина та же, но плотность берётся не
// непрерывно, а ступенями — по одной на ячейку полосы. Вместе с фильтрацией «ближайший
// сосед», которую ставит отрисовщик, это даёт тень, сложенную из квадратов растра.
//
// ЗАЧЕМ. Тень должна говорить о плотности застройки, и вопрос, каким языком она это делает —
// плавным пятном или сеткой ячеек, — решается сравнением на глаз. Второй язык вдобавок
// честнее: навигация судит о проходимости именно по ячейкам, и ступень проходит ровно там,
// где меняется решение растра.
//
// Прочее — перевод расстояния в свободное место, шкала цвета, угасание к границе полосы —
// устроено так же и теми же величинами, что в плавном варианте.
shader_type canvas_item;

uniform sampler2D ramp : source_color, filter_linear, repeat_disable;

// Ширина полосы затенения, пикселей свободного места
uniform float width_px = 40.0;

// Сила угасания к границе полосы
uniform float falloff = 1.0;

// Ячейка растра навигации, пикселей
uniform float cell_px = 16.0;

// Шаг chamfer-расстояния по стороне: во сколько долей ячейки считается расстояние
uniform float steps_per_cell = 3.0;

void fragment() {
	float steps = texture(TEXTURE, UV).r * 255.0;

	float free_px = (steps / steps_per_cell - 0.5) * cell_px;
	float t = clamp(free_px / max(width_px, 0.001), 0.0, 1.0);

	// Ступеней столько, сколько ячеек растра укладывается в полосу: дробить мельче нечего,
	// поскольку само расстояние меряется ячейками
	float levels = max(floor(width_px / max(cell_px, 1.0)), 1.0);
	float quantized = floor(t * levels) / levels;

	vec4 tint = texture(ramp, vec2(quantized, 0.0));
	tint.a *= pow(1.0 - quantized, falloff);

	COLOR = tint;
}
