; Настройка мира: размер поля, раскладка точек метала, кольцо появления противника.
; Величины подбираются глазом по карте, поэтому правятся здесь, а видны в предпросмотре —
; scenes/tools/Preview.tscn.
;
; ВНИМАНИЕ. Эти комментарии живут ровно до первого сохранения из инспектора: движок
; переписывает .tres целиком и всё, чего нет в свойствах, теряет.

[gd_resource type="Resource" script_class="WorldSettings" load_steps=2 format=3]

[ext_resource type="Script" uid="uid://y5qf2c1v7038" path="res://scripts/world/WorldSettings.cs" id="1_settings"]

[resource]
script = ExtResource("1_settings")

; Клеток от центра до края: мир — квадрат 41×41 клетка с центром в точке высадки.
; Меняется между партиями, а не по ходу: от размера зависит растр навигации
RadiusCells = 20

; ── Точки метала ─────────────────────────────────────────────────────────────────────
;
; Все точки одинаковы: разницу создаёт только положение — до дальней дольше идти
; и труднее её прикрыть

SpotCount = 14

; Поле точек кончается за пять клеток до края мира: у самой границы экстрактор
; не поставить, там не хватает места под зазор
FieldRadiusCells = 15

; Ближе четырёх клеток точек нет, иначе они встают прямо под стартовую базу
BaseClearanceCells = 4

; Меньшее расстояние собирает точки в кучу, и один экстрактор прикрывает сразу несколько —
; выбор «куда расширяться» при этом обесценивается
SpacingCells = 3

; Три точки гарантированно лежат в восьми клетках от старта: раскладка, оставившая начало
; без метала, проиграна до первого решения игрока
StartCount = 3
StartRadiusCells = 8

Attempts = 60

; Ноль — раскладка своя на каждую партию. Ненулевое значение делает её воспроизводимой,
; и та же раскладка показывается предпросмотром в редакторе
Seed = 0

; ── Появление противника ─────────────────────────────────────────────────────────────
;
; Окружность появления дальше поля точек: враги приходят из-за него, поэтому дальние
; точки лежат на линии подхода, и добыча на краю кольца перестаёт быть безопасной.
; От этого же радиуса отсчитывается форма появления волн

RingFactor = 1.3
