; Настройка террора — числовой меры того, насколько игрок себя обнаружил.
; Описание механики целиком: docs/gamedesign/terror.md
;
; ВНИМАНИЕ. Эти комментарии живут ровно до первого сохранения из инспектора: движок
; переписывает .tres целиком и всё, чего нет в свойствах, теряет. Правка кривых мышью —
; это и есть сохранение. Поэтому здесь только подсказки на первое чтение, а несущее
; объяснение лежит в TerrorSettings.cs и в документе; потеряв комментарии, ничего не
; потеряете по существу.

[gd_resource type="Resource" script_class="TerrorSettings" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/pressure/TerrorSettings.cs" id="1_settings"]

; ── Кривые насыщения ──────────────────────────────────────────────────────────────
;
; Все три задают x^0.6 на отрезке 0..1 шестью точками. Кривая нужна НЕ чтобы гасить
; прибавку: база растёт примерно экспоненциально, и вогнутая кривая переводит этот рост
; в примерно линейный рост давления. Хотите, чтобы слагаемое насыщалось быстрее, —
; поднимайте левую часть кривой; хотите, чтобы дольше росло линейно, — распрямляйте.
;
; Горизонтальный участок в конце не рисуйте: он означал бы, что после некоторого размера
; расширение бесплатно. За единицей кривая всё равно продолжается прямой с наклоном Tail.

[sub_resource type="Curve" id="Curve_production"]
_data = [Vector2(0, 0), 0.0, 4.0, 0, 0, Vector2(0.1, 0.2512), 1.5071, 1.5071, 0, 0, Vector2(0.25, 0.4353), 1.0447, 1.0447, 0, 0, Vector2(0.5, 0.6598), 0.7917, 0.7917, 0, 0, Vector2(0.75, 0.8415), 0.6732, 0.6732, 0, 0, Vector2(1, 1), 0.6, 0.0, 0, 0]
point_count = 6

[sub_resource type="Curve" id="Curve_expansion"]
_data = [Vector2(0, 0), 0.0, 4.0, 0, 0, Vector2(0.1, 0.2512), 1.5071, 1.5071, 0, 0, Vector2(0.25, 0.4353), 1.0447, 1.0447, 0, 0, Vector2(0.5, 0.6598), 0.7917, 0.7917, 0, 0, Vector2(0.75, 0.8415), 0.6732, 0.6732, 0, 0, Vector2(1, 1), 0.6, 0.0, 0, 0]
point_count = 6

[sub_resource type="Curve" id="Curve_army"]
_data = [Vector2(0, 0), 0.0, 4.0, 0, 0, Vector2(0.1, 0.2512), 1.5071, 1.5071, 0, 0, Vector2(0.25, 0.4353), 1.0447, 1.0447, 0, 0, Vector2(0.5, 0.6598), 0.7917, 0.7917, 0, 0, Vector2(0.75, 0.8415), 0.6732, 0.6732, 0, 0, Vector2(1, 1), 0.6, 0.0, 0, 0]
point_count = 6

[resource]
script = ExtResource("1_settings")

; Шаг пересчёта и замера, секунд. Он же шаг ряда в регистре сведений, где номер замера
; служит отметкой времени, — поэтому по ходу партии меняться не может. Уменьшать имеет
; смысл только ради подробности графика: на сам показатель шаг не влияет
SampleInterval = 1.0

; Постоянная сглаживания, секунд. Задержка, с которой ДАВЛЕНИЕ следует за показателем.
; Больше — тем дольше держится память о снесённом форпосте. Ноль сделал бы выгодным
; снос собственных построек перед волной. Игроку показывается мгновенное значение,
; так что на плашках эта величина никак не отразится
SmoothingSeconds = 60.0

; Сколько энергии стоит единица метала при сложении двух потоков в один.
; Это курс экстрактора (18 энергии на 5 метала). Увеличить — энергия станет весить
; меньше, и генераторы перестанут заметно двигать показатель
EnergyPerMetal = 3.6

; ── Зоны удалённости ──────────────────────────────────────────────────────────────
;
; Расстояние отсчитывается от точки высадки, а не от текущего центра базы: иначе рост
; базы сам собой удешевлял бы уже поставленные дальние постройки.
; Мир — квадрат радиусом 20 клеток, точки метала лежат в пределах 15.

; Радиус зоны высадки в клетках: всё внутри считается ближним тылом
NearRadiusCells = 8.0

; Внешний радиус средней зоны в клетках. Дальше — фронтир
MidRadiusCells = 15.0

; Множители веса постройки по зонам. Разрыв между ними и есть цена роста наружу:
; сузите его — и вопрос «куда расти» потеряет вес, расширьте — и фронтир станет
; неподъёмным задолго до портала
NearZone = 0.2
MidZone = 1.0
FarZone = 2.5

; ── Производство ──────────────────────────────────────────────────────────────────
;
; Вход: поток метала плюс выработка энергии, приведённая по курсу выше. Считается
; ВАЛОВАЯ выработка, поэтому портал показатель не снижает, а построенные ради него
; генераторы — повышают.
;
; Вес этого слагаемого намеренно ниже двух остальных. Поднимете вровень — выгодной
; станет стратегия отказа от экономики, а она обесценивает первый узел петли.

ProductionCurve = SubResource("Curve_production")

; Величина входа, которая считается полной: на ней кривая доходит до конца, а дальше
; идёт прямой. Для ориентира: коммандер в одиночку даёт около 10
ProductionReference = 200.0

; Вклад слагаемого в очках террора при полном входе
ProductionWeight = 20.0

; Наклон прямой за опорным значением. Ноль дал бы потолок и бесплатный рост после него
ProductionTail = 0.15

; ── Экспансия ─────────────────────────────────────────────────────────────────────
;
; Вход: сумма весов построек, умноженных на коэффициент зоны. Вес отдельной постройки
; живёт не здесь, а в её .toml, секция [terror], ключ expansion. Каркасы не считаются.
;
; Самое весомое слагаемое: показатель прежде всего про территорию.

ExpansionCurve = SubResource("Curve_expansion")

; Полный вход. Для ориентира при весе постройки в единицу: это примерно тридцать
; построек на фронтире либо полторы сотни в зоне высадки
ExpansionReference = 150.0
ExpansionWeight = 45.0
ExpansionTail = 0.15

; ── Армия ─────────────────────────────────────────────────────────────────────────
;
; Вход: сумма весов подвижных сущностей игрока, без географии. Вес — ключ army в том же
; разделе [terror] .toml-файла. Турели сюда не входят, они считаются по экспансии.

ArmyCurve = SubResource("Curve_army")

; Полный вход. При весе юнита в единицу это шестьдесят боевых юнитов
ArmyReference = 60.0
ArmyWeight = 35.0
ArmyTail = 0.15

; Показатель степени, по которому считается вклад, ЕСЛИ КРИВАЯ НЕ НАЗНАЧЕНА. Страховка
; от пустого поля в инспекторе: без неё подсчёт упал бы целиком. Меньше единицы —
; вогнутая кривая, единица — прямая пропорция
FallbackExponent = 0.6
