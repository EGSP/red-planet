; Настройка подсистемы волн: то, что действует на все волны разом. Отдельная волна
; описывается файлом в resources/waves/ и переопределяет отсюда лишь то, чем отличается.
; Описание механики целиком — в WaveSystem.cs.
;
; ВНИМАНИЕ. Эти комментарии живут ровно до первого сохранения из инспектора: движок
; переписывает .tres целиком и всё, чего нет в свойствах, теряет.

[gd_resource type="Resource" script_class="WaveSettings" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/pressure/WaveSettings.cs" id="1_settings"]

[resource]
script = ExtResource("1_settings")

; Постоянная отдыха между волнами, секунд. Волна умножает её своим множителем, поэтому
; здесь стоит обиходный случай: полторы минуты между накатами
ChillInterval = 90.0

; Отсрочка первой волны. Заметно больше отсрочки фона (30 с): к первой волне у игрока
; должны быть хотя бы турели, а до того давление идёт одним фоном
FirstDelay = 120.0

; Доля разброса интервала. Десятая часть от полутора минут даёт разброс около девяти
; секунд в обе стороны — достаточно, чтобы готовиться с запасом, а не по секундомеру
ChillIntervalOffset = 0.1

; ── Умолчания формы появления ────────────────────────────────────────────────────────
;
; Ближняя дуга уже дальней: наступление сходится к базе остриём, а не идёт ровной стеной.
; Такая волна бьёт в одну точку обороны, и это делает её отличимой от фона, который
; приходит из случайной точки всей окружности

NearArcDegrees = 30.0
FarArcDegrees = 40.0

; Ближняя дуга стоит ровно на радиусе появления фона, глубина — восьмая часть того же
; радиуса. При радиусе поля метала это около трёх-четырёх клеток в глубину
RadiusOffsetMultiplier = 1.0
RadiusDepthMultiplier = 0.12

; Промежуток между центрами мест. Клетка с запасом покрывает самый крупный вид
; (радиус корпуса 0.45, то есть безопасный минимум 0.9)
SpacingCells = 1.0

; Один очаг: волна приходит с одной стороны. Разнесённые очаги задаются волной
Groups = 1
GroupsArcDegrees = 90.0
